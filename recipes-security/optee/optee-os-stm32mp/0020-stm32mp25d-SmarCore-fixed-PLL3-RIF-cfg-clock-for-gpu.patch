From b596bb87745dacadd9075f9b8936d03b7de8c8ee Mon Sep 17 00:00:00 2001
From: FraUtel <francesco.utel@engicam.com>
Date: Tue, 8 Jul 2025 10:15:40 +0200
Subject: [PATCH] stm32mp25d SmarCore: fixed PLL3 RIF cfg clock for gpu IAC
 exception

---
 .../arm/dts/stm32mp257d-smarcored-xtouch10-mx-rif.dtsi    | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp257d-smarcored-xtouch10-mx-rif.dtsi b/core/arch/arm/dts/stm32mp257d-smarcored-xtouch10-mx-rif.dtsi
index 3dba4c4f2..781703abd 100644
--- a/core/arch/arm/dts/stm32mp257d-smarcored-xtouch10-mx-rif.dtsi
+++ b/core/arch/arm/dts/stm32mp257d-smarcored-xtouch10-mx-rif.dtsi
@@ -130,9 +130,9 @@
 		RIMUPROT(RIMU_ID(7), RIF_CID1, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_P) /* RIMU IP = ETH2 */
 		RIMUPROT(RIMU_ID(0), RIF_CID1, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_M) /* RIMU IP = ETR */
 		RIMUPROT(RIMU_ID(9), RIF_CID1, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_P) /* RIMU IP = GPU */
-		RIMUPROT(RIMU_ID(11), RIF_CID4, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_M) /* RIMU IP = LTDC_L1L2 */
-		RIMUPROT(RIMU_ID(12), RIF_CID4, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_M) /* RIMU IP = LTDC_L3 */
-		RIMUPROT(RIMU_ID(13), RIF_CID4, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_M) /* RIMU IP = LTDC_ROT */
+		RIMUPROT(RIMU_ID(11), RIF_CID4, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_P) /* RIMU IP = LTDC_L1L2 */
+		RIMUPROT(RIMU_ID(12), RIF_CID4, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_P) /* RIMU IP = LTDC_L3 */
+		RIMUPROT(RIMU_ID(13), RIF_CID4, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_P) /* RIMU IP = LTDC_ROT */
 		RIMUPROT(RIMU_ID(8), RIF_CID1, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_P) /* RIMU IP = PCIE */
 		RIMUPROT(RIMU_ID(1), RIF_CID1, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_P) /* RIMU IP = SDMMC1 */
 		RIMUPROT(RIMU_ID(2), RIF_CID1, RIF_NSEC, RIF_NPRIV,RIF_CIDSEL_P) /* RIMU IP = SDMMC2 */
@@ -569,7 +569,7 @@
 		RIFPROT(RIF_RCC_RESOURCE(102), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = RTC_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(103), RIF_UNUSED, RIF_UNLOCK, RIF_SEC, RIF_NPRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = BSEC_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(104), EMPTY_SEMWL, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_EN, RIF_CFEN) /* Feature = DDRC_CFGR */
-		RIFPROT(RIF_RCC_RESOURCE(105), EMPTY_SEMWL, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_EN, RIF_CFEN) /* Feature = PLL3_CFGR */
+		RIFPROT(RIF_RCC_RESOURCE(105), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = PLL3_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(106), RIF_UNUSED, RIF_UNLOCK, RIF_SEC, RIF_NPRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = SYSCPU1_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(108), EMPTY_SEMWL, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_EN, RIF_CFEN) /* Feature = MCO1_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(109), EMPTY_SEMWL, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_EN, RIF_CFEN) /* Feature = MCO2_CFGR */
