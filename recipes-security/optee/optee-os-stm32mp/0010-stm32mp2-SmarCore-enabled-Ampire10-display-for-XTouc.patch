From c7a4c28be284ccfac0ef4ce32467c684987d9b9e Mon Sep 17 00:00:00 2001
From: FraUtel <francesco.utel@engicam.com>
Date: Fri, 10 Jan 2025 11:27:29 +0100
Subject: [PATCH] stm32mp2 SmarCore: enabled Ampire10 display for XTouch2.0 kit

---
 .../arm/dts/stm32mp257f-smarcore-xtouch10-mx-rif.dtsi     | 4 ++--
 core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx.dts    | 8 ++++++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx-rif.dtsi b/core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx-rif.dtsi
index d659f90e7..c58c01b47 100644
--- a/core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx-rif.dtsi
+++ b/core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx-rif.dtsi
@@ -90,7 +90,7 @@
 		RIFPROT(STM32MP25_RIFSC_SPI8_ID, EMPTY_SEMWL, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_UNUSED, RIF_SEM_EN, RIF_CFEN)
 		RIFPROT(STM32MP25_RIFSC_STGEN_ID, RIF_UNUSED, RIF_LOCK, RIF_SEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
 		RIFPROT(STM32MP25_RIFSC_TIM1_ID, RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
-		RIFPROT(STM32MP25_RIFSC_TIM2_ID, RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_CID2, RIF_SEM_DIS, RIF_CFEN)
+		RIFPROT(STM32MP25_RIFSC_TIM2_ID, RIF_CID1_BF|RIF_CID2_BF, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_EN, RIF_CFEN)
 		RIFPROT(STM32MP25_RIFSC_TIM3_ID, RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
 		RIFPROT(STM32MP25_RIFSC_TIM4_ID, RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
 		RIFPROT(STM32MP25_RIFSC_TIM5_ID, RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
@@ -561,7 +561,7 @@
 		RIFPROT(RIF_RCC_RESOURCE(96), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = GPIOG_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(97), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = GPIOH_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(98), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = GPIOI_CFGR */
-		RIFPROT(RIF_RCC_RESOURCE(99), RIF_CID1_BF, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_EN, RIF_CFEN) /* Feature = GPIOJ_CFGR */
+		RIFPROT(RIF_RCC_RESOURCE(99), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_EN, RIF_CFEN) /* Feature = GPIOJ_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(100), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = GPIOK_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(101), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = GPIOZ_CFGR */
 		RIFPROT(RIF_RCC_RESOURCE(102), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN) /* Feature = RTC_CFGR */
diff --git a/core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx.dts b/core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx.dts
index 404099bd5..6acfc1120 100644
--- a/core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx.dts
+++ b/core/arch/arm/dts/stm32mp257f-smarcore-xtouch10-mx.dts
@@ -649,5 +649,13 @@
 &gpiod {
 	st,protreg = <RIFPROT(RIF_IOPORT_PIN(3), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_DIS, RIF_CFDIS)>; /* PD9 */
 };
+
+&gpioi {
+	st,protreg = <RIFPROT(RIF_IOPORT_PIN(1), RIF_UNUSED,  RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)>;
+};
+
+&gpioz{
+	st,protreg = <RIFPROT(RIF_IOPORT_PIN(1), RIF_UNUSED,  RIF_UNLOCK, RIF_NSEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)>;
+};
 /* USER CODE END addons */
 
