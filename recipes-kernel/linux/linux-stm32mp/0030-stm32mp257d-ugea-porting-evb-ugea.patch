+
+&sai1 { /*SGTL 5000*/
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sai1a_pins_mx>, <&sai1b_pins_mx>;
+	pinctrl-1 = <&sai1a_sleep_pins_mx>, <&sai1b_sleep_pins_mx>;
+	status = "okay";
+
+	sai1a:audio-controller@40290004{
+		status = "okay";
+
+		#clock-cells = <0>;
+		dma-names = "tx";
+		sai1a_port: port {
+			sai1a_endpoint: endpoint {
+					remote-endpoint = <&sgtl5000_tx_endpoint>;
+					format = "i2s";
+					mclk-fs = <256>;
+			};
+		};
+	};
+
+	sai1b:audio-controller@40290024{
+		status = "okay";
+
+		st,sync = <&sai1a 2>;
+		clocks = <&rcc CK_KER_SAI1>, <&sai1a>;
+		clock-names = "sai_ck", "MCLK";
+		dma-names = "rx";
+
+		sai1b_port: port {
+			sai1b_endpoint: endpoint {
+				remote-endpoint = <&sgtl5000_rx_endpoint>;
+				format = "i2s";
+				mclk-fs = <256>;
+			};
+		};
+	};
+};
+
+&m_can1 { /*CAN 1*/
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&fdcan1_pins_mx>;
+	pinctrl-1 = <&fdcan1_sleep_pins_mx>;
+	status = "okay";
+};
+
+&m_can2 { /*CAN 2*/
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&fdcan2_pins_mx>;
+	pinctrl-1 = <&fdcan2_sleep_pins_mx>;
+	status = "okay";
+};
+
+&m33_rproc {
+	status = "okay";
+
+	compatible = "st,stm32mp2-m33-tee";
+	mboxes = <&ipcc1 0x100>, <&ipcc1 0x101>, <&ipcc1 2>;
+	mbox-names = "vq0", "vq1", "shutdown";
+	memory-region = <&cm33_cube_fw>, <&cm33_cube_data>,
+	<&ipc_shmem_1>, <&vdev0vring0>,
+	<&vdev0vring1>, <&vdev0buffer>,
+	<&cm33_sram2>;
+	st,syscfg-nsvtor = <&a35ss_syscfg 0xa8 0xffffff80>;
+};
+
+&rtc {
+	status = "okay";
+};
+
+&sdmmc1 {
+	pinctrl-names = "default", "opendrain", "sleep";
+	pinctrl-0 = <&sdmmc1_pins_mx>;
+	pinctrl-1 = <&sdmmc1_opendrain_pins_mx>;
+	pinctrl-2 = <&sdmmc1_sleep_pins_mx>;
+	status = "okay";
+
+	broken-cd;
+	disable-wp;
+	st,neg-edge;
+	bus-width = <4>;
+	vmmc-supply = <&scmi_v3v3>;
+	vqmmc-supply = <&scmi_vddio1>;
+	sd-uhs-sdr12;
+	sd-uhs-sdr25;
+	sd-uhs-sdr50;
+	sd-uhs-ddr50;
+	sd-uhs-sdr104;
+};
+
+&sdmmc2 {
+	pinctrl-names = "default", "opendrain", "sleep";
+	pinctrl-0 = <&sdmmc2_pins_mx>;
+	pinctrl-1 = <&sdmmc2_opendrain_pins_mx>;
+	pinctrl-2 = <&sdmmc2_sleep_pins_mx>;
+	status = "okay";
+
+	non-removable;
+	no-sd;
+	no-sdio;
+	st,neg-edge;
+	bus-width = <8>;
+	vmmc-supply = <&scmi_v3v3>;
+	vqmmc-supply = <&scmi_vddio2>;
+	mmc-ddr-1_8v;
+	mmc-hs200-1_8v;	
+};
+
+&sdmmc3 { /*WIFI/BT*/
+	pinctrl-names = "default", "opendrain", "sleep";
+	pinctrl-0 = <&sdmmc3_pins_mx>;
+	pinctrl-1 = <&sdmmc3_opendrain_pins_mx>;
+	pinctrl-2 = <&sdmmc3_sleep_pins_mx>;
+	status = "okay";
+
+	non-removable;
+	/delete-property/ st,neg-edge;
+	no-1-8-v;
+	pm-ignore-notify;
+	keep-power-in-suspend;	
+	bus-width = <4>;
+	vmmc-supply = <&scmi_v3v3>;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	status = "okay";
+};
+
+&spi1 { /*SPI - TPM, Expansion connector*/
+	pinctrl-names = "default";//, "sleep";
+	pinctrl-0 = <&spi1_pins_mx>;
+	pinctrl-1 = <&spi1_sleep_pins_mx>;
+	status = "okay";
+	cs-gpios = <&gpioh 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+	
+	tpm@0 {
+        compatible = "infineon,slb9670", "tcg,tpm_tis-spi";
+        reg = <0>; /* Matches the first (and only) CS defined in cs-gpios */
+        spi-max-frequency = <38000000>; /* Max freq for SLB9670 */
+        reset-gpios = <&gpioh 11 GPIO_ACTIVE_LOW>;
+    };
+};
+
+&usart1 { /*RS 232*/
+	pinctrl-names = "default", "idle", "sleep";
+	pinctrl-0 = <&usart1_pins_mx>;
+	pinctrl-1 = <&usart1_idle_pins_mx>;
+	pinctrl-2 = <&usart1_sleep_pins_mx>;
+	status = "okay";
+
+	/delete-property/dmas;
+	/delete-property/dma-names;	
+};
+
+&usart2 { /*CONSOLE*/
+	pinctrl-names = "default", "idle", "sleep";
+	pinctrl-0 = <&usart2_pins_mx>;
+	pinctrl-1 = <&usart2_idle_pins_mx>;
+	pinctrl-2 = <&usart2_sleep_pins_mx>;
+	status = "okay";
+
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+};
+
+&uart5 { /*UART5 - EXPANSION CONNECTOR - RS232*/
+	pinctrl-names = "default", "idle", "sleep";
+	pinctrl-0 = <&uart5_pins_mx>;
+	pinctrl-1 = <&uart5_idle_pins_mx>;
+	pinctrl-2 = <&uart5_sleep_pins_mx>;
+	status = "okay";
+};
+
+&usart6 { /*RS 485*/
+	pinctrl-names = "default", "idle", "sleep";
+	pinctrl-0 = <&usart6_pins_mx>;
+	pinctrl-1 = <&usart6_idle_pins_mx>;
+	pinctrl-2 = <&usart6_sleep_pins_mx>;
+	status = "okay";
+
+	//uart-has-rtscts;
+	linux,rs485-enabled-at-boot-time;
+};
+
+&uart7 { /*WIFI/BT*/
+	pinctrl-names = "default", "idle", "sleep";
+	pinctrl-0 = <&uart7_pins_mx>;
+	pinctrl-1 = <&uart7_idle_pins_mx>;
+	pinctrl-2 = <&uart7_sleep_pins_mx>;
+	status = "okay";
+	uart-has-rtscts;
+};
+
+&usb2_phy1 { /*USB phy*/
+	status = "okay";
+	vdd33-supply = <&scmi_vdd3v3_usb>;
+};
+
+&usb2_phy2 { /*USB phy*/
+	status = "okay";
+	vdd33-supply = <&scmi_vdd3v3_usb>;
+};
+
+&usb3dr { /*USB controller - Dual role*/
+	status = "okay";
+
+	dwc3:usb@48300000{ /*Maps the physical usb-c port*/
+		maximum-speed = "high-speed";
+		dr_mode = "otg";
+        usb-role-switch;
+        role-switch-default-mode = "peripheral";
+
+		//port{
+		//	dwc3_ep:endpoint{
+		//		remote-endpoint = <&typec_ep>;
+		//	};
+		//};
+	};
+};
+
+&usbh {  /*USB controller - Host*/
+	status = "okay";
+
+	usbh_ehci:usb@482f0000{ /*Maps the usb-A ports as an hub*/
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		hub@1{ 
+			compatible = "usb424,2514";
+			reg = <1>;
+			vdd-supply = <&scmi_v3v3>;
+		};
+	};
+};
+
+&ltdc { /*LVDS/LTDC*/
+    status = "okay";
+    pinctrl-names = "default", "sleep";
+    pinctrl-0 = <&ltdc_pins_mx>; 
+    pinctrl-1 = <&ltdc_sleep_pins_mx>;
+
+    port {
+        ltdc_out_rgb: endpoint {
+            remote-endpoint = <&panel_in_rgb>; /* Point back to panel */
+        };
+    };
+};
+
+&timers2 { /* LVDS/LTDC */
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&tim2_pwm_pins_mx>;
+	pinctrl-1 = <&tim2_pwm_sleep_pins_mx>; /*PI7 TIM2_CH1*/
+	status = "okay";
+
+	pwm2: pwm {
+		status = "okay";
+		/delete-property/ pinctrl-names;
+        /delete-property/ pinctrl-0;
+        /delete-property/ pinctrl-1;
+	};
+};
+
+&a35ss_syscfg{
+	status = "okay";
+};
+
+&arm_wdt{
+	timeout-sec = <32>;
+	status = "okay";
+};
+
+&cs_cpu_debug0{
+	status = "okay";
+};
+
+&cs_cpu_debug1{
+	status = "okay";
+};
+
+&cs_cti0{
+	status = "okay";
+};
+
+&cs_cti1{
+	status = "okay";
+};
+
+&cs_cti_cpu0{
+	status = "okay";
+};
+
+&cs_cti_cpu1{
+	status = "okay";
+};
+
+&cs_etf{
+	status = "okay";
+};
+
+&cs_etm0{
+	status = "disabled";
+};
+
+&cs_etm1{
+	status = "disabked";
+};
+
+&mlahb{ /*Multi-Layer Advanced High-performance Bus*/
+
+	intc_rpmsg:interrupt-controller@1{ /*Remote Processor Messaging - Allows the cortex35 to talk to the cortex33*/
+		compatible = "rpmsg,intc";
+		reg = <1 0>;
+		#interrupt-cells = <1>;
+		interrupt-controller;
+	};
+
+	i2c_rpmsg:i2c@2{ /*interrupt controller - */
+		compatible = "rpmsg,i2c-controller";
+		reg = <2 0>;
+		rpmsg,dev-id = "rpmsg_i2c";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "disabled";
+
+		typec@35{ /*USB - links the usb dwc3 controller to the usb-c physical port*/
+			compatible = "st,stm32mp25-typec";
+			reg = <0x35>;
+			interrupts-extended = <&intc_rpmsg 0>;
+			status = "disabled";
+
+			connector{
+				compatible = "usb-c-connector";
+				label = "USB-C";
+
+				//port{
+				//	typec_ep:endpoint{
+				//		remote-endpoint = <&dwc3_ep>;
+				//	};
+				//};
+			};
+		};
+	};
+};
+
+&scmi_regu{
+
+	scmi_vddio1:regulator@0{
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	scmi_vddcore:regulator@11{
+		reg = <VOLTD_SCMI_STPMIC2_BUCK2>;
+		regulator-name = "vddcore";
+	};
+
+	scmi_v1v8:regulator@14{
+		reg = <VOLTD_SCMI_STPMIC2_BUCK5>;
+		regulator-name = "v1v8";
+	};
+
+	scmi_v3v3:regulator@16{
+		reg = <VOLTD_SCMI_STPMIC2_BUCK7>;
+		regulator-name = "v3v3";
+	};
+
+	scmi_vdd3v3_usb:regulator@20{ /*USB - power suply*/
+		reg = <VOLTD_SCMI_STPMIC2_LDO4>;
+		regulator-name = "vdd3v3_usb";
+	};
+};
