Subject: [PATCH] Added device tree for stm32mp2 iCore for C.Touch3 with
 Ampire10 display

---
 .../st/stm32mp257f-icore-ctouch3-ampire10.dts | 1502 +++++++++++++++++
 1 file changed, 1502 insertions(+)
 create mode 100644 arch/arm64/boot/dts/st/stm32mp257f-icore-ctouch3-ampire10.dts

diff --git a/arch/arm64/boot/dts/st/stm32mp257f-icore-ctouch3-ampire10.dts b/arch/arm64/boot/dts/st/stm32mp257f-icore-ctouch3-ampire10.dts
new file mode 100644
index 000000000..a08260031
--- /dev/null
+++ b/arch/arm64/boot/dts/st/stm32mp257f-icore-ctouch3-ampire10.dts
@@ -0,0 +1,1502 @@
+// SPDX-License-Identifier: (GPL-2.0-or-later OR BSD-3-Clause)
+/*
