+					 <STM32_PINMUX('E', 8, AF12)>, /* SDMMC2_D2 */
+					 <STM32_PINMUX('E', 9, AF12)>, /* SDMMC2_D5 */
+					 <STM32_PINMUX('E', 10, AF12)>, /* SDMMC2_D4 */
+					 <STM32_PINMUX('E', 11, AF12)>, /* SDMMC2_D1 */
+					 <STM32_PINMUX('E', 12, AF12)>, /* SDMMC2_D3 */
+					 <STM32_PINMUX('E', 13, AF12)>; /* SDMMC2_D0 */
