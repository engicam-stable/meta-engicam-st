+			pinmux = <STM32_PINMUX('J', 0, ANALOG)>; /* PCIE_CLKREQN */
+		};
+	};
+
+	sai1a_pins_mx: sai1a_mx-0 {
+		pins {
+			pinmux = <STM32_PINMUX('D', 8, AF3)>, /* SAI1_FS_A */
+					 <STM32_PINMUX('D', 9, AF3)>, /* SAI1_SD_A */
+					 <STM32_PINMUX('D', 10, AF3)>, /* SAI1_SCK_A */
+					 <STM32_PINMUX('D', 11, AF3)>; /* SAI1_MCLK_A */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+	};
+
+	sai1a_sleep_pins_mx: sai1a_sleep_mx-0 {
+		pins {
+			pinmux = <STM32_PINMUX('D', 8, ANALOG)>, /* SAI1_FS_A */
+					 <STM32_PINMUX('D', 9, ANALOG)>, /* SAI1_SD_A */
+					 <STM32_PINMUX('D', 10, ANALOG)>, /* SAI1_SCK_A */
+					 <STM32_PINMUX('D', 11, ANALOG)>; /* SAI1_MCLK_A */
+		};
+	};
+
+	sai1b_pins_mx: sai1b_mx-0 {
+		pins {
+			pinmux = <STM32_PINMUX('D', 4, AF4)>; /* SAI1_SD_B */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+	};
+
+	sai1b_sleep_pins_mx: sai1b_sleep_mx-0 {
+		pins {
+			pinmux = <STM32_PINMUX('D', 4, ANALOG)>; /* SAI1_SD_B */
+		};
+	};
+	
+	sdmmc1_pins_mx: sdmmc1_mx-0 {
+		pins1 {
+			pinmux = <STM32_PINMUX('E', 0, AF10)>, /* SDMMC1_D2 */
