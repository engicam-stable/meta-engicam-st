+/dts-v1/;
+
+#include <dt-bindings/pinctrl/stm32-pinfunc.h>
+#include "stm32mp257.dtsi"
+#include "stm32mp25xf.dtsi"
+#include "stm32mp257f-microgea-edimm2-mx-resmem.dtsi"
+#include "stm32mp25xxal-pinctrl.dtsi"
+
+/* USER CODE BEGIN includes */
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/regulator/st,stm32mp25-regulator.h>
+/* USER CODE END includes */
+
+/ {
+	model = "Engicam MicroGEA STM32MP257AL EDIMM2.0 board - openstlinux-6.1-yocto-mickledore-mpu-v24.06.26";
+	compatible = "st,stm32mp257f-microgea-edimm2-mx", "st,stm32mp257f-ev1", "st,stm32mp257";
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x40000000>;
+
+		/* USER CODE BEGIN memory */
+		/* USER CODE END memory */
+	};
+
+	/* USER CODE BEGIN root */
+
+	aliases{
+		ethernet0 = &eth1;
+		serial0 = &usart2;
+		serial1 = &usart6;
+		serial2 = &lpuart1;
+		serial3 = &usart1;
+		serial4 = &uart7;
+		rtc = &pcf8523;
+		rtc1 = &rtc;		
+	};
+
+	chosen{
+		stdout-path = "serial0:115200n8";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		framebuffer {
+			compatible = "simple-framebuffer";
+			clocks = <&rcc CK_BUS_LTDC>, <&rcc CK_KER_LTDC>,
+				 <&rcc CK_BUS_LVDS>, <&rcc CK_KER_LVDSPHY>;
+			status = "disabled";
+		};
+	};
+
+	panel_rgb: panel-rgb {
+		compatible = "panel-dpi";		
+		backlight = <&panel_rgb_backlight>;
+		status = "okay";
+
+		width-mm = <108>;
+		height-mm = <65>;
+		data-mapping = "rgb24";
+		
+		panel-timing {
+                clock-frequency = <25000000>;
+                //clock-frequency = <51450000>;
+                hactive = <800>;
+                vactive = <480>;
+                hback-porch = <8>;
+                hfront-porch = <8>;
+                vback-porch = <8>;
+                vfront-porch = <8>;
+                hsync-len = <4>;
+                vsync-len = <4>;
+                hsync-active = <0>;
+                vsync-active = <0>;
+                de-active = <1>;
+                pixelclk-active = <0>;
+		};
+
+		port {
+			panel_in_rgb: endpoint {
+				remote-endpoint = <&ltdc_ep0_out>;
+			};
+		};
+	};
+
+	panel_lvds:panel-lvds{
+		compatible = "panel-lvds";
+		backlight = <&panel_lvds_backlight>;
+		status = "disabled";
+		width-mm = <156>;
+		height-mm = <92>;
+		data-mapping = "vesa-24";
+
+		panel-timing {
+			clock-frequency = <65000000>;
+			hactive = <1024>;
+			vactive = <600>;
+			hback-porch = <160>;
+			hfront-porch = <20>;
+			vback-porch = <29>;
+			vfront-porch = <3>;
+			hsync-len = <136>;
+			vsync-len = <6>;
+			hsync-active = <0>;
+			vsync-active = <0>;
+			de-active = <1>;
+			pixelclk-active = <0>;
+		};
+
+		port{
+
+			lvds_panel_in0:endpoint{
+				remote-endpoint = <&lvds_out0>;
+			};
+		};
+
+	};
+
+	panel_rgb_backlight:panel-rgb-backlight{
+		compatible = "gpio-backlight";
+		gpios = <&gpioi 7 GPIO_ACTIVE_HIGH>;
+		default-on;
+		default-brightness-level = <7>;
+		status = "okay";
+	};
+
+	panel_lvds_backlight:panel-lvds-backlight{
+		compatible = "gpio-backlight";
+		gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
+		default-on;
+		default-brightness-level = <7>;
+		status = "disabled";
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&gpioc 7 1>;
+		startup-delay-us = <10000>;
+		enable-active-high;
+	};
+
+	wifi_mode: regulator-wifi_mode {
+		compatible = "regulator-fixed";
+		regulator-name = "wifi_mode";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpioc 8 0>;
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "tas2780-audio";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&dailink_master1>;
+		simple-audio-card,frame-master = <&dailink_master1>;
+
+		dailink_master1: simple-audio-card,cpu {
+			sound-dai = <&sai1a &sai1b>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&tas2780>;
+		};
+	};	
+	/* USER CODE END root */
+
+	clocks{
+
+		/* USER CODE BEGIN clocks */
+
+		cec_clock:cec-clock{
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <12000000>;
+		};
+
+		clk_ext_camera:clk-ext-camera{
+			#clock-cells = <0>;
+			compatible = "fixed-clock";
+			clock-frequency = <24000000>;
+		};
+
+		pad_clk:pad-clk{
+			#clock-cells = <0>;
+			compatible = "fixed-clock";
+			clock-frequency = <100000000>;
+		};
+
+		/* USER CODE END clocks */
+	};
+
+}; /*root*/
+
