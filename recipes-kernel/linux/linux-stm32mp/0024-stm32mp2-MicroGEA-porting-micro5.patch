+			pinmux = <STM32_PINMUX('B', 4, ANALOG)>, /* I2C2_SDA */
+					 <STM32_PINMUX('B', 5, ANALOG)>; /* I2C2_SCL */
+		};
+	};
+
+	ltdc_pins_mx: ltdc_mx-0 {
+		pins1 {
+			pinmux = <STM32_PINMUX('A', 1, AF11)>, /* LTDC_R3 */
