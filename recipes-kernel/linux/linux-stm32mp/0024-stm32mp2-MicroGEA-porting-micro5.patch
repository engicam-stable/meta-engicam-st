+					 <STM32_PINMUX('C', 11, AF13)>, /* LTDC_R2 */
+					 <STM32_PINMUX('F', 5, AF13)>, /* LTDC_B6 */
+					 <STM32_PINMUX('F', 6, AF13)>, /* LTDC_B0 */
+					 <STM32_PINMUX('F', 7, AF13)>, /* LTDC_R1 */
+					 <STM32_PINMUX('F', 8, AF13)>, /* LTDC_G0 */
+					 <STM32_PINMUX('G', 1, AF13)>, /* LTDC_VSYNC */
