+	};
+
+	vddio3:vddio3{
+		vddio3-supply = <&v1v8>;
+	};
+
+	vddio4:vddio4{
+		vddio4-supply = <&v1v8>;
+	};
+
+	vddio:vddio{
+		vdd-supply = <&vddio_pmic>;
+	};	
+	/* USER CODE END pwr */
+};
+
+&rng{
+	status = "okay";
+
+	/* USER CODE BEGIN rng */
+	/* USER CODE END rng */
+};
+
+&sdmmc1{
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc1_pins_mx>;
+	status = "okay";
+
+	/* USER CODE BEGIN sdmmc1 */
