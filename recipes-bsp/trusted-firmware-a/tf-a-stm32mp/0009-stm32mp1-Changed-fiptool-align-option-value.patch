From 44b990123db571b1ba66942f5dafb072b04740c6 Mon Sep 17 00:00:00 2001
From: il_dude <support@engicam.com>
Date: Mon, 23 Mar 2026 12:23:49 +0100
Subject: [PATCH] stm32mp1 - Changed fiptool align option value

---
 plat/st/stm32mp1/platform.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/plat/st/stm32mp1/platform.mk b/plat/st/stm32mp1/platform.mk
index 97cedb514..15a9a6dfc 100644
--- a/plat/st/stm32mp1/platform.mk
+++ b/plat/st/stm32mp1/platform.mk
@@ -182,6 +182,7 @@ FIP_DEPS		+=	dtbs
 STM32MP_HW_CONFIG	:=	${BL33_CFG}
 STM32MP_FW_CONFIG_NAME	:=	$(patsubst %.dtb,%-fw-config.dtb,$(DTB_FILE_NAME))
 STM32MP_FW_CONFIG	:=	${BUILD_PLAT}/fdts/$(STM32MP_FW_CONFIG_NAME)
+FIP_ARGS := "2048"
 ifneq (${AARCH32_SP},none)
 FDT_SOURCES		+=	$(addprefix fdts/, $(patsubst %.dtb,%.dts,$(STM32MP_FW_CONFIG_NAME)))
 endif
