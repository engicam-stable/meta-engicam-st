+	vdd2-supply = <&vdd2_ddr>; // phandle to the VDD2/VDDCA regulator device tree node.
+	vddq-supply = <&vdd2_ddr>; // phandle to the VDDQ regulator device tree node.
+	/* USER CODE END ddr */
