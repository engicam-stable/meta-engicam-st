From dc077efabb68c187952620d91745ab651dede438 Mon Sep 17 00:00:00 2001
From: FraUtel <francesco.utel@engicam.com>
Date: Fri, 25 Oct 2024 10:34:58 +0200
Subject: [PATCH] Set internal pull-up on uart4 RX

---
 arch/arm/dts/stm32mp135d-gea-starterkit-mx.dts      | 2 +-
 arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts       | 2 +-
 arch/arm/dts/stm32mp135f-ugea-microdev-mx.dts       | 2 +-
 arch/arm/dts/stm32mp157a-icore-ctouch2-amp10-mx.dts | 2 +-
 arch/arm/dts/stm32mp157a-icore-starterkit-mx.dts    | 2 +-
 arch/arm/dts/stm32mp157a-ugea-microdev-mx.dts       | 2 +-
 6 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/arch/arm/dts/stm32mp135d-gea-starterkit-mx.dts b/arch/arm/dts/stm32mp135d-gea-starterkit-mx.dts
index ea390fd5f6..599132f952 100644
--- a/arch/arm/dts/stm32mp135d-gea-starterkit-mx.dts
+++ b/arch/arm/dts/stm32mp135d-gea-starterkit-mx.dts
@@ -472,7 +472,7 @@
 		};
 		pins2 {
 			pinmux = <STM32_PINMUX('D', 8, AF8)>; /* UART4_RX */
-			bias-disable;
+			bias-pull-up;
 		};
 	};
 
diff --git a/arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts b/arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts
index 4fcb4ae78f..a812be9159 100644
--- a/arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts
+++ b/arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts
@@ -392,7 +392,7 @@
 		};
 		pins2 {
 			pinmux = <STM32_PINMUX('H', 14, AF8)>; /* UART4_RX */
-			bias-disable;
+			bias-pull-up;
 		};
 	};
 
diff --git a/arch/arm/dts/stm32mp135f-ugea-microdev-mx.dts b/arch/arm/dts/stm32mp135f-ugea-microdev-mx.dts
index 36bb36c396..7f28467640 100644
--- a/arch/arm/dts/stm32mp135f-ugea-microdev-mx.dts
+++ b/arch/arm/dts/stm32mp135f-ugea-microdev-mx.dts
@@ -353,7 +353,7 @@
 		};
 		pins2 {
 			pinmux = <STM32_PINMUX('H', 14, AF8)>; /* UART4_RX */
-			bias-disable;
+			bias-pull-up;
 		};
 	};
 
diff --git a/arch/arm/dts/stm32mp157a-icore-ctouch2-amp10-mx.dts b/arch/arm/dts/stm32mp157a-icore-ctouch2-amp10-mx.dts
index 9aa0b42d56..adfff74f90 100644
--- a/arch/arm/dts/stm32mp157a-icore-ctouch2-amp10-mx.dts
+++ b/arch/arm/dts/stm32mp157a-icore-ctouch2-amp10-mx.dts
@@ -576,7 +576,7 @@
 	uart4_pins_mx: uart4_mx-0 {
 		pins1 {
 			pinmux = <STM32_PINMUX('B', 2, AF8)>; /* UART4_RX */
-			bias-disable;
+			bias-pull-up;
 		};
 		pins2 {
 			pinmux = <STM32_PINMUX('G', 11, AF6)>; /* UART4_TX */
diff --git a/arch/arm/dts/stm32mp157a-icore-starterkit-mx.dts b/arch/arm/dts/stm32mp157a-icore-starterkit-mx.dts
index d92c717dc5..45774fe45d 100644
--- a/arch/arm/dts/stm32mp157a-icore-starterkit-mx.dts
+++ b/arch/arm/dts/stm32mp157a-icore-starterkit-mx.dts
@@ -596,7 +596,7 @@
 	uart4_pins_mx: uart4_mx-0 {
 		pins1 {
 			pinmux = <STM32_PINMUX('B', 2, AF8)>; /* UART4_RX */
-			bias-disable;
+			bias-pull-up;
 		};
 		pins2 {
 			pinmux = <STM32_PINMUX('G', 11, AF6)>; /* UART4_TX */
diff --git a/arch/arm/dts/stm32mp157a-ugea-microdev-mx.dts b/arch/arm/dts/stm32mp157a-ugea-microdev-mx.dts
index 54f79cdc49..13a05321fd 100644
--- a/arch/arm/dts/stm32mp157a-ugea-microdev-mx.dts
+++ b/arch/arm/dts/stm32mp157a-ugea-microdev-mx.dts
@@ -480,7 +480,7 @@
 	uart4_pins_mx: uart4_mx-0 {
 		pins1 {
 			pinmux = <STM32_PINMUX('B', 2, AF8)>; /* UART4_RX */
-			bias-disable;
+			bias-pull-up;
 		};
 		pins2 {
 			pinmux = <STM32_PINMUX('G', 11, AF6)>; /* UART4_TX */
