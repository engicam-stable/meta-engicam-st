From 6ca83d256c8188bcb32747e998a58b3b73474c77 Mon Sep 17 00:00:00 2001
From: FraUtel <francesco.utel@engicam.com>
Date: Tue, 21 Jan 2025 17:54:58 +0100
Subject: [PATCH] stm32mp2: enabled env overwrite

---
 configs/stm32mp25_defconfig          | 1 +
 configs/stm32mp25_smarcore_defconfig | 1 +
 2 files changed, 2 insertions(+)

diff --git a/configs/stm32mp25_defconfig b/configs/stm32mp25_defconfig
index 9db4402f8a..3ae5af5470 100644
--- a/configs/stm32mp25_defconfig
+++ b/configs/stm32mp25_defconfig
@@ -60,6 +60,7 @@ CONFIG_CMD_MTDPARTS=y
 CONFIG_CMD_LOG=y
 CONFIG_CMD_UBI=y
 CONFIG_OF_LIVE=y
+CONFIG_ENV_OVERWRITE=y
 CONFIG_ENV_IS_NOWHERE=y
 CONFIG_ENV_IS_IN_FLASH=y
 CONFIG_ENV_IS_IN_MMC=y
diff --git a/configs/stm32mp25_smarcore_defconfig b/configs/stm32mp25_smarcore_defconfig
index 8673366421..d0da1eead1 100644
--- a/configs/stm32mp25_smarcore_defconfig
+++ b/configs/stm32mp25_smarcore_defconfig
@@ -60,6 +60,7 @@ CONFIG_CMD_MTDPARTS=y
 CONFIG_CMD_LOG=y
 CONFIG_CMD_UBI=y
 CONFIG_OF_LIVE=y
+CONFIG_ENV_OVERWRITE=y
 CONFIG_ENV_IS_NOWHERE=y
 CONFIG_ENV_IS_IN_FLASH=y
 CONFIG_ENV_IS_IN_MMC=y
