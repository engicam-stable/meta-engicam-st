From be3ff0d57b182f5d0c430e37a0b89af35ada3595 Mon Sep 17 00:00:00 2001
From: Fabio Aiuto <fabio.aiuto@engicam.com>
Date: Mon, 9 Jun 2025 11:44:45 +0200
Subject: [PATCH] arch: arm: dts: stm32mp135d-ugea-microdev-mx: enable display

Enable display.
---
 arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts | 180 ++++++++++++++++++
 1 file changed, 180 insertions(+)

diff --git a/arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts b/arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts
index 6d82671f65..af6af3f880 100644
--- a/arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts
+++ b/arch/arm/dts/stm32mp135d-ugea-microdev-mx.dts
@@ -70,6 +70,45 @@
 		};
 	};
 
+	panel_pwr: regulator-panel_pwr {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_pwr";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpioc 2 0>;
+		regulator-always-on;
+	};
+
+	lcd_3v3: reg-lcd_3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd_3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpiob 1 0>;
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	panel_backlight: panel-backlight {
+		compatible = "gpio-backlight";
+		gpio = <&gpioe 12 GPIO_ACTIVE_HIGH>;
+		default-on;
+		default-brightness-level = <0>;
+		status = "okay";
+	};
+
+	panel_rgb: panel-rgb {
+		compatible = "auo,b101aw03";
+		backlight = <&panel_backlight>;
+		power-supply = <&lcd_3v3>;
+		status = "okay";
+		port {
+			panel_in_rgb: endpoint {
+				remote-endpoint = <&ltdc_out_rgb>;
+			};
+		};
+	};
+
 	v3v3_ao: v3v3_ao {
 		compatible = "regulator-fixed";
 		regulator-name = "v3v3_ao";
@@ -148,6 +187,97 @@
 		};
 	};
 
+	i2c2_pins_mx: i2c2_mx-0 {
+		pins {
+			pinmux = <STM32_PINMUX('D', 7, AF4)>, /* I2C2_SCL */
+					 <STM32_PINMUX('G', 9, AF4)>; /* I2C2_SDA */
+			bias-disable;
+			drive-open-drain;
+			slew-rate = <0>;
+		};
+	};
+
+	i2c2_sleep_pins_mx: i2c2_sleep_mx-0 {
+		pins {
+			pinmux = <STM32_PINMUX('D', 7, ANALOG)>, /* I2C2_SCL */
+					 <STM32_PINMUX('G', 9, ANALOG)>; /* I2C2_SDA */
+		};
+	};
+
+	ltdc_pins_mx: ltdc_mx-0 {
+		pins1 {
+			pinmux = <STM32_PINMUX('A', 9, AF14)>, /* LTDC_R6 */
+					 <STM32_PINMUX('A', 15, AF9)>, /* LTDC_R0 */
+					 <STM32_PINMUX('B', 10, AF14)>, /* LTDC_R3 */
+					 <STM32_PINMUX('B', 12, AF14)>, /* LTDC_VSYNC */
+					 <STM32_PINMUX('D', 5, AF13)>, /* LTDC_B0 */
+					 <STM32_PINMUX('D', 10, AF9)>, /* LTDC_G5 */
+					 <STM32_PINMUX('D', 14, AF14)>, /* LTDC_R4 */
+					 <STM32_PINMUX('E', 1, AF9)>, /* LTDC_HSYNC */
+					 <STM32_PINMUX('E', 6, AF14)>, /* LTDC_G3 */
+					 <STM32_PINMUX('E', 9, AF14)>, /* LTDC_R7 */
+					 <STM32_PINMUX('E', 13, AF11)>, /* LTDC_B1 */
+					 <STM32_PINMUX('E', 14, AF14)>, /* LTDC_G0 */
+					 <STM32_PINMUX('E', 15, AF14)>, /* LTDC_B7 */
+					 <STM32_PINMUX('F', 1, AF14)>, /* LTDC_G1 */
+					 <STM32_PINMUX('F', 2, AF13)>, /* LTDC_G4 */
+					 <STM32_PINMUX('F', 5, AF14)>, /* LTDC_R5 */
+					 <STM32_PINMUX('F', 8, AF14)>, /* LTDC_B3 */
+					 <STM32_PINMUX('F', 9, AF14)>, /* LTDC_B6 */
+					 <STM32_PINMUX('F', 10, AF14)>, /* LTDC_B5 */
+					 <STM32_PINMUX('G', 1, AF14)>, /* LTDC_G7 */
+					 <STM32_PINMUX('G', 7, AF11)>, /* LTDC_R1 */
+					 <STM32_PINMUX('H', 3, AF14)>, /* LTDC_B4 */
+					 <STM32_PINMUX('H', 7, AF14)>, /* LTDC_B2 */
+					 <STM32_PINMUX('H', 8, AF14)>, /* LTDC_R2 */
+					 <STM32_PINMUX('H', 9, AF11)>, /* LTDC_DE */
+					 <STM32_PINMUX('H', 11, AF14)>, /* LTDC_G6 */
+					 <STM32_PINMUX('H', 13, AF14)>; /* LTDC_G2 */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+		pins2 {
+			pinmux = <STM32_PINMUX('D', 9, AF13)>; /* LTDC_CLK */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <1>;
+		};
+	};
+
+	ltdc_sleep_pins_mx: ltdc_sleep_mx-0 {
+		pins {
+			pinmux = <STM32_PINMUX('A', 9, ANALOG)>, /* LTDC_R6 */
+					 <STM32_PINMUX('A', 15, ANALOG)>, /* LTDC_R0 */
+					 <STM32_PINMUX('B', 10, ANALOG)>, /* LTDC_R3 */
+					 <STM32_PINMUX('B', 12, ANALOG)>, /* LTDC_VSYNC */
+					 <STM32_PINMUX('D', 5, ANALOG)>, /* LTDC_B0 */
+					 <STM32_PINMUX('D', 9, ANALOG)>, /* LTDC_CLK */
+					 <STM32_PINMUX('D', 10, ANALOG)>, /* LTDC_G5 */
+					 <STM32_PINMUX('D', 14, ANALOG)>, /* LTDC_R4 */
+					 <STM32_PINMUX('E', 1, ANALOG)>, /* LTDC_HSYNC */
+					 <STM32_PINMUX('E', 6, ANALOG)>, /* LTDC_G3 */
+					 <STM32_PINMUX('E', 9, ANALOG)>, /* LTDC_R7 */
+					 <STM32_PINMUX('E', 13, ANALOG)>, /* LTDC_B1 */
+					 <STM32_PINMUX('E', 14, ANALOG)>, /* LTDC_G0 */
+					 <STM32_PINMUX('E', 15, ANALOG)>, /* LTDC_B7 */
+					 <STM32_PINMUX('F', 1, ANALOG)>, /* LTDC_G1 */
+					 <STM32_PINMUX('F', 2, ANALOG)>, /* LTDC_G4 */
+					 <STM32_PINMUX('F', 5, ANALOG)>, /* LTDC_R5 */
+					 <STM32_PINMUX('F', 8, ANALOG)>, /* LTDC_B3 */
+					 <STM32_PINMUX('F', 9, ANALOG)>, /* LTDC_B6 */
+					 <STM32_PINMUX('F', 10, ANALOG)>, /* LTDC_B5 */
+					 <STM32_PINMUX('G', 1, ANALOG)>, /* LTDC_G7 */
+					 <STM32_PINMUX('G', 7, ANALOG)>, /* LTDC_R1 */
+					 <STM32_PINMUX('H', 3, ANALOG)>, /* LTDC_B4 */
+					 <STM32_PINMUX('H', 7, ANALOG)>, /* LTDC_B2 */
+					 <STM32_PINMUX('H', 8, ANALOG)>, /* LTDC_R2 */
+					 <STM32_PINMUX('H', 9, ANALOG)>, /* LTDC_DE */
+					 <STM32_PINMUX('H', 11, ANALOG)>, /* LTDC_G6 */
+					 <STM32_PINMUX('H', 13, ANALOG)>; /* LTDC_G2 */
+		};
+	};
+
 	sdmmc1_pins_mx: sdmmc1_mx-0 {
 		pins1 {
 			pinmux = <STM32_PINMUX('C', 8, AF12)>, /* SDMMC1_D0 */
@@ -410,6 +540,11 @@
 	};
 
 	/* USER CODE BEGIN pinctrl */
+	pinctrl_edt_ft5x26: pinctrl_edt_ft5x26-0 {
+		pins {
+			pinmux = <STM32_PINMUX('E', 2, GPIO)>;
+		};
+	};
 	/* USER CODE END pinctrl */
 };
 
@@ -459,6 +594,51 @@
 	/* USER CODE END ethernet1 */
 };
 
+&i2c2 {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&i2c2_pins_mx>;
+	pinctrl-1 = <&i2c2_sleep_pins_mx>;
+	status = "okay";
+
+	/* USER CODE BEGIN i2c2 */
+	i2c-scl-rising-time-ns = <300>;
+	i2c-scl-falling-time-ns = <300>;
+	clock-frequency = <400000>;
+	/delete-property/dmas;
+	/delete-property/dma-names;
+
+
+	polytouch: edt-ft5x26@38 {
+		compatible = "edt,edt-ft5x26";
+		reg = <0x38>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_edt_ft5x26>;
+		interrupt-parent = <&gpioe>;
+		interrupts = <2 IRQ_TYPE_EDGE_RISING>;
+	};
+	/* USER CODE END i2c2 */
+};
+
+&ltdc {
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&ltdc_pins_mx>;
+	pinctrl-1 = <&ltdc_sleep_pins_mx>;
+	status = "okay";
+
+	/* USER CODE BEGIN ltdc */
+	powerdown-gpios = <&gpioa 0 1>;
+
+	port@0{
+		#address-cells = <1>;
+		#size-cells = <0>;
+			ltdc_out_rgb: endpoint@0 {
+			reg = <0>;
+			remote-endpoint = <&panel_in_rgb>;
+		};
+	};
+	/* USER CODE END ltdc */
+};
+
 &m_can2 {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&fdcan2_pins_mx>;
